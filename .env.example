# ==============================================================================
# 🖥️ OPEN COMPUTER CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env (install.sh does this automatically) and fill in what you use.
# All settings are also editable via Settings (⚙️) in the web UI.

# ------------------------------------------------------------------------------
# 1. Open Computer User & Authentication
# ------------------------------------------------------------------------------
# Open Computer signs in via Linux PAM authentication using a dedicated non-root user.
# If you are setting up with an AI assistant prompt, specify your desired username & password
# so the system/assistant creates the user for you on your VPS.
# Defaults to the Linux user running the service (e.g. 'opencomputer' or 'suop').
# SU_LOGIN_USER=opencomputer

# ------------------------------------------------------------------------------
# 2. Public Access via Cloudflare Tunnel (Optional - Recommended for HTTPS)
# ------------------------------------------------------------------------------
# Access your Open Computer securely from anywhere with a custom domain and SSL (no open ports).
# Create a free tunnel in Cloudflare Zero Trust > Networks > Tunnels pointing to http://localhost:8000
# and paste your tunnel token below. Start with: docker compose up -d cloudflared
# CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# 3. AI Model Keys: Add at least one API key
# ------------------------------------------------------------------------------
# Provide an API key for your preferred AI model provider:
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=

# Local models (Ollama, llama-server, vLLM):
# LOCAL_LLM_URL=http://127.0.0.1:11434/v1

# Provider:model ID (valid IDs listed in the Settings picker):
# SU_DEFAULT_MODEL=openrouter:anthropic/claude-sonnet-4.5
# Model for scheduled automations (defaults to SU_DEFAULT_MODEL):
# SU_AUTOMATION_MODEL=
# Model for Build mode (defaults to the model picked in the chat):
# SU_BUILD_MODEL=
# Cheap model for short helper calls: request triage, memory extraction, history folding, JSON conversion (defaults to SU_DEFAULT_MODEL):
# SU_QUICK_MODEL=
# Comma-separated list to hide providers you do not use:
# SU_DISABLED_PROVIDERS=
# Claude Code and Gemini CLI: install the CLI and sign in as this Linux user; Open Computer finds them in ~/.local/bin or PATH.

# ------------------------------------------------------------------------------
# 4. Gateway & Networking
# ------------------------------------------------------------------------------
# Bind address; keep 127.0.0.1 and put a Cloudflare tunnel or reverse proxy in front
SU_HOST=127.0.0.1
SU_PORT=8000
# Bearer token for scripts and the API (install.sh generates one automatically)
SU_TOKEN=
# Signs the sign-in session cookie (install.sh generates one automatically)
SU_SESSION_SECRET=
# e.g. https://computer.yourdomain.com when reachable through a tunnel or proxy
SU_PUBLIC_URL=
# Timezone for scheduled automations and dates (IANA name, e.g. America/New_York)
SU_TZ=UTC
# Seconds of inactivity before the browser session ends (default 600 = 10 min; max 12 hours)
# SU_SESSION_IDLE=600
# Set to 1 only if a reverse proxy on another machine sends X-Forwarded-For; local proxies & Cloudflare tunnels need nothing
# SU_TRUST_PROXY=
# What the assistant calls itself in prompts and the UI (default SU)
# SU_AGENT_NAME=
# systemd unit the updater restarts (default su, as install.sh creates)
# SU_SERVICE_NAME=
# Docker container of a quick (token-less) cloudflared tunnel; its trycloudflare URL is copied into SU_PUBLIC_URL
# SU_TUNNEL_CONTAINER=
# Token budget the chat loop assumes for the model context (default 120000, 32768 for local models)
# SU_CONTEXT_BUDGET=

# ------------------------------------------------------------------------------
# 5. Reporting & Notifications (Optional)
# ------------------------------------------------------------------------------
# Where automations and alerts are sent
# NOTIFY_EMAIL=
# Send email via Resend, or use SMTP_* below:
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# Who send_email may write to besides owner: addresses or @domains, comma-separated, * for anyone:
# SU_MAIL_SEND_TO=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 6. Web & Browserless Tool (Optional)
# ------------------------------------------------------------------------------
# Hosts web_fetch may reach on private or local networks, comma-separated (blocked otherwise):
# SU_FETCH_ALLOWED_HOSTS=
# Web search is powered by TinyFish (api.search.tinyfish.ai); without a key it falls back to scraping DuckDuckGo:
# TINYFISH_API_KEY=
# Optional two-letter country code for search results, e.g. US, GB, DE:
# SU_SEARCH_LOCATION=
# Headless Chromium from docker-compose.yml for JavaScript-heavy pages & screenshots (view_webpage tool):
# BROWSERLESS_URL=http://127.0.0.1:3000
# BROWSERLESS_TOKEN=
# Public URL for http services started as tasks, if your tunnel or proxy maps hostnames to them; {label} and {port} are filled in.
# Without it, http services are private at <SU_PUBLIC_URL>/api/svc/<label>/ behind the gateway login.
# SU_SERVICE_URL_PATTERN=https://{label}.example.com

# ------------------------------------------------------------------------------
# 7. Connected Apps (Pipedream Connect - Optional)
# ------------------------------------------------------------------------------
# PIPEDREAM_CLIENT_ID=
# PIPEDREAM_CLIENT_SECRET=
# PIPEDREAM_PROJECT_ID=
# PIPEDREAM_ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 8. Media Generation (Optional)
# ------------------------------------------------------------------------------
# e.g. openrouter:google/gemini-2.5-flash-image
# SU_IMAGE_MODEL=
# SU_VIDEO_MODEL=
# FAL_KEY=
# Speech and transcription through any OpenAI-compatible provider's /audio endpoints (provider:model), e.g. openai:whisper-1 or groq:whisper-large-v3
# SU_SPEECH_MODEL=
# SU_SPEECH_VOICE=
# SU_TRANSCRIBE_MODEL=

# 6. Auto-update (Optional)
# SU_AUTO_UPDATE=1 pulls the latest commit from the git remote and restarts whenever the repo moves ahead. SU_UPDATE_INTERVAL is the check interval in seconds.
SU_AUTO_UPDATE=0
SU_UPDATE_INTERVAL=3600
