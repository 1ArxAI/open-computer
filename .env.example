# SU settings. Copy to .env (install.sh does this) and fill in what you use. Everything here is also editable in Settings.

# --- gateway ---
# bind address; keep 127.0.0.1 and put a tunnel or reverse proxy in front
SU_HOST=127.0.0.1
SU_PORT=8000
# Bearer token for scripts and the API (install.sh generates one)
SU_TOKEN=
# signs the sign-in cookie (install.sh generates one)
SU_SESSION_SECRET=
# e.g. https://su.example.com when reachable through a tunnel or proxy
SU_PUBLIC_URL=
# timezone for schedules and dates
SU_TZ=Europe/London
# seconds of inactivity before the browser session ends (default 600); the hard cap is 12 hours
# SU_SESSION_IDLE=600
# set to 1 only if a reverse proxy on another machine sends X-Forwarded-For; local proxies and Cloudflare tunnels need nothing
# SU_TRUST_PROXY=
# Linux user allowed to sign in; defaults to the user running the service
# SU_LOGIN_USER=

# --- models: add at least one key. The Settings page shows what each provider offers. ---
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=
# any OpenAI-compatible server: llama-server, Ollama, vLLM
# LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# provider:model; the picker lists valid ids
# SU_DEFAULT_MODEL=openrouter:anthropic/claude-sonnet-4.5
# model for scheduled automations (defaults to SU_DEFAULT_MODEL)
# SU_AUTOMATION_MODEL=
# model for Build mode (defaults to SU_DEFAULT_MODEL)
# SU_BUILD_MODEL=
# comma list to hide providers you do not use
# SU_DISABLED_PROVIDERS=
# Claude Code and Gemini CLI: install the CLI and sign in as this Linux user; SU finds them in ~/.local/bin or PATH.

# --- reporting ---
# where automations and alerts are sent
# NOTIFY_EMAIL=
# send_email via Resend, or use SMTP_* below
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# who send_email may write to besides the owner: addresses or @domains, comma separated, * for anyone
# SU_MAIL_SEND_TO=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- web ---
# hosts web_fetch may reach on private or local networks, comma separated (blocked otherwise)
# SU_FETCH_ALLOWED_HOSTS=
# web search (falls back to DuckDuckGo without it)
# TINYFISH_API_KEY=
# headless Chromium from docker-compose.yml, for JavaScript pages and screenshots
# BROWSERLESS_URL=http://127.0.0.1:3000

# --- connected apps (Pipedream Connect) ---
# PIPEDREAM_CLIENT_ID=
# PIPEDREAM_CLIENT_SECRET=
# PIPEDREAM_PROJECT_ID=
# PIPEDREAM_ENVIRONMENT=development

# --- media ---
# e.g. openrouter:google/gemini-2.5-flash-image
# SU_IMAGE_MODEL=
# SU_VIDEO_MODEL=
# FAL_KEY=

# --- public HTTPS via Cloudflare (docker-compose.yml) ---
# CLOUDFLARE_TUNNEL_TOKEN=
